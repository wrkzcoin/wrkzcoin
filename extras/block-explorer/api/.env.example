NODE_ENV=production
HOST=127.0.0.1
PORT=8080

# Browser origin allowed for CORS. Use your domain in production.
CORS_ORIGIN=*

# Daemon RPC upstream
DAEMON_RPC_URL=http://127.0.0.1:11898
DAEMON_RPC_TOKEN=
REQUEST_TIMEOUT_MS=10000

# API rate limiting (per-IP, per minute)
API_MAX_RPM=300

# Short TTL caches
CACHE_TTL_INFO_MS=3000
CACHE_TTL_BLOCK_MS=15000
CACHE_TTL_TX_MS=15000

# SQLite index (lightweight block metadata only)
SQLITE_DB_PATH=./data/explorer-index.db
INDEXER_ENABLED=true
INDEX_PAYMENT_IDS=true
INDEXER_BATCH_SIZE=100
INDEXER_POLL_INTERVAL_MS=15000

# Optional remote daemon consistency check
REMOTE_DAEMON_RPC_URL=
REMOTE_DAEMON_RPC_TOKEN=

# Required for admin operations (index repair, deep health checks with repair)
ADMIN_API_KEY=
